# Copy to android/key.properties (git-ignored) and fill in.
# Create the key once with:
#   keytool -genkey -v -keystore android/upload-keystore.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias upload
storeFile=../upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
# Real AdMob app id (optional here; env var ADMOB_APP_ID_ANDROID also works)
ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
